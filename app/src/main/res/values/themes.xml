<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the platform theme only sets the window background
         so there is no flash before the first frame. -->
    <style name="Theme.KrsLocation" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/shad_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
